{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "start", "-w", "apps/frontend"],
      "port": 3000
    },
    {
      "name": "backend",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "start", "-w", "apps/backend"],
      "port": 3001
    },
    {
      "name": "frontend-local",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "-w", "apps/frontend"],
      "env": { "API_PROXY_TARGET": "http://localhost:3001" },
      "port": 3000
    }
  ]
}
