# Banco (Postgres). Local em Docker: docker run -d --name comanda-db -e POSTGRES_USER=comanda -e POSTGRES_PASSWORD=comanda -e POSTGRES_DB=comanda_db -p 127.0.0.1:5435:5432 postgres:16-alpine
DATABASE_URL="postgresql://comanda:comanda@localhost:5435/comanda_db"

# Segredos (obrigatórios; o servidor não sobe sem JWT_SECRET). Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="troque-por-um-segredo-longo-e-aleatorio"
# Chave da criptografia do segredo do 2FA (opcional; usa JWT_SECRET se faltar)
TWO_FACTOR_KEY=""

# App
PORT=3001
NODE_ENV=development
# Origens do frontend permitidas no CORS, separadas por vírgula
CORS_ORIGINS="http://localhost:3000"
